[Unit]
Description=Weekly update for My Website: Git, Build, MongoDB Import, and Restart Backend

[Service]
Type=oneshot
User=builduser
WorkingDirectory=/var/www/My-Website
ExecStart=/bin/bash -c ' \
  git pull && \
  cd frontend && \
  npm install && \
  npm run build && \
  mongosh --eval "db.blogs.drop()" --db test && \
  cd backend && \
  npm install && \
  mongoimport --db test --collection blogs --file ./dump/test/blogs.json && \
  systemctl restart my-website-backend.service'
